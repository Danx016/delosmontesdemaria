# ==============================================================================
# VARIABLES DE ENTORNO — DE LOS MONTES DE MARÍA S.A.S
# Copia este archivo a .env y llena tus credenciales privadas.
# ==============================================================================

# --- Servidor ---
NODE_ENV=production
PORT=3000
HTTPS_PORT=3443
BASE_URL=https://delosmontesdemaria.duckdns.org
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui

# --- Base de Datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASS=tu_contrasena_de_base_de_datos
DB_NAME=dbmontesdm
DB_SSL=false

# --- Correo Electrónico (Gmail SMTP / Brevo / Resend) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail
BREVO_API_KEY=
RESEND_API_KEY=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# --- Asistente de Inteligencia Artificial (OpenRouter) ---
OPENROUTER_API_KEY=tu_openrouter_api_key
OPENROUTER_MODEL=minimax/minimax-m3:free

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
TELEGRAM_BOT_USERNAME=montesdemariabot
TELEGRAM_ADMIN_CHAT_ID=tu_telegram_admin_chat_id

# --- Pasarela de Pagos Wompi ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_KEY=
